# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-value
SECURITY_PASSWORD_SALT=change-me-to-another-long-random-value

# SMTP for password reset/change emails (Mailjet shown; any provider works).
# A single verified sender address is enough -- no domain purchase needed
# (Mailjet: Sender addresses; SendGrid: Single Sender Verification).
MAIL_SERVER=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=<mailjet-api-key>
MAIL_PASSWORD=<mailjet-secret-key>
MAIL_DEFAULT_SENDER=FamQuiz <you@your-verified-sender.com>
SECURITY_EMAIL_SENDER=FamQuiz <you@your-verified-sender.com>

# Single family-wide Ollama key.
OLLAMA_API_KEY=
# Optional overrides: cloud text model (must be covered by free credits)
# and API host.
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_HOST=https://ollama.com
